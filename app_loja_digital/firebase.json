{
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": [
    {
      "target": "loja_ju",
      "public": "build/web_loja_ju",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [{ "source": "**", "destination": "/index.html" }],
      "headers": [
        {
          "source": "/@(index.html|manifest.json|flutter_bootstrap.js|flutter_service_worker.js|main.dart.js)",
          "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
        }
      ]
    },
    {
      "target": "loja_gi",
      "public": "build/web_loja_gi",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [{ "source": "**", "destination": "/index.html" }],
      "headers": [
        {
          "source": "/@(index.html|manifest.json|flutter_bootstrap.js|flutter_service_worker.js|main.dart.js)",
          "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
        }
      ]
    }
  ],
  "emulators": {
    "auth": { "port": 9099 },
    "firestore": { "port": 8080 },
    "storage": { "port": 9199 },
    "ui": { "enabled": true, "port": 4000 },
    "singleProjectMode": true
  },
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "loja-digital-ju0714",
          "appId": "1:954686759385:android:18a00934fbd92d081cb9c8",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "ios": {
        "default": {
          "projectId": "loja-digital-ju0714",
          "appId": "1:954686759385:ios:32999fafd199b7681cb9c8",
          "uploadDebugSymbols": false,
          "fileOutput": "ios/Runner/GoogleService-Info.plist"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "loja-digital-ju0714",
          "configurations": {
            "android": "1:954686759385:android:18a00934fbd92d081cb9c8",
            "ios": "1:954686759385:ios:32999fafd199b7681cb9c8",
            "web": "1:954686759385:web:a5c9c285b916f6ca1cb9c8"
          }
        }
      }
    }
  }
}
